#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"

if [[ "$(uname -s)" != Linux ]]; then
    echo 'This setup is for Debian orbs, not a local macOS environment.' >&2
    exit 1
fi

export DEBIAN_FRONTEND=noninteractive
export COMPOSER_NO_INTERACTION=1
TIMEFORMAT='Step completed in %3R seconds'
trap 'echo "Orb setup failed at line $LINENO" >&2' ERR

echo 'Installing missing system packages (PHP 8.5)'
time {
    packages=(ca-certificates curl unzip git
        php8.5-cli php8.5-curl php8.5-mbstring php8.5-xml php8.5-sqlite3
        php8.5-zip php8.5-intl php8.5-bcmath)
    missing=()
    for package in "${packages[@]}"; do
        if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
            missing+=("$package")
        fi
    done
    if ((${#missing[@]})); then
        if [[ ! -f /etc/apt/sources.list.d/firstlight-php.list ]]; then
            sudo apt-get update -qq
            sudo apt-get install -y --no-install-recommends ca-certificates curl
            keyring="$(mktemp --suffix=.deb)"
            curl -fsSL --retry 3 https://packages.sury.org/debsuryorg-archive-keyring.deb -o "$keyring"
            sudo dpkg -i "$keyring"
            rm -f -- "$keyring"
            echo 'deb [signed-by=/usr/share/keyrings/debsuryorg-archive-keyring.gpg] https://packages.sury.org/php/ bookworm main' |
                sudo tee /etc/apt/sources.list.d/firstlight-php.list >/dev/null
        fi
        sudo apt-get update -qq
        sudo apt-get install -y --no-install-recommends "${missing[@]}"
    fi
    sudo ln -sfn /usr/bin/php8.5 /usr/local/bin/php
    # Pest uses assertions while loading its configuration; Debian disables them by default.
    echo 'zend.assertions=1' | sudo tee /etc/php/8.5/cli/conf.d/99-firstlight-dev.ini >/dev/null
}

echo 'Installing Composer'
time {
    if ! command -v composer >/dev/null; then
        installer="$(mktemp)"
        curl -fsSL --retry 3 https://getcomposer.org/installer -o "$installer"
        expected="$(curl -fsSL --retry 3 https://composer.github.io/installer.sig)"
        [[ "$(sha384sum "$installer" | cut -d ' ' -f 1)" == "$expected" ]]
        sudo php "$installer" --2 --install-dir=/usr/local/bin --filename=composer
        rm -f -- "$installer"
    fi
}

echo 'Installing PHP dependencies'
time composer install --no-progress

echo 'Orb ready: run vendor/bin/pest and vendor/bin/testbench native:plugin:validate "$PWD".'
