{
    "name": "firstlightui/local-ocr",
    "description": "On-device multi-page document capture and OCR for NativePHP Mobile, using VisionKit and Apple Vision on iOS and ML Kit on Android.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "homepage": "https://firstlightui.dev",
    "keywords": [
        "android",
        "ios",
        "nativephp",
        "ocr",
        "document-scanner"
    ],
    "authors": [
        {
            "name": "Firstlight UI",
            "email": "team@firstlightui.dev"
        }
    ],
    "support": {
        "email": "team@firstlightui.dev",
        "issues": "https://github.com/firstlightui/local-ocr/issues",
        "source": "https://github.com/firstlightui/local-ocr"
    },
    "require": {
        "php": "^8.4",
        "nativephp/mobile": "^4.6.1"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "pestphp/pest": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "FirstlightUI\\LocalOcr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FirstlightUI\\LocalOcr\\LocalOcrServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
